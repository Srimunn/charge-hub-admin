# ─── Frontend (Railway service: charge-hub-frontend, root directory: /) ───
# Copy to .env.local for local dev. On Railway, set these in the service's Variables tab.
# NEXT_PUBLIC_* values are baked in at BUILD time — redeploy after changing them.
# Never commit real values.

PORT=3000

# Public backend URL the browser calls (API + Socket.io)
NEXT_PUBLIC_API_URL=https://operator-api.magnertia.in
# Optional: only if Socket.io is served from a different host than the API
# NEXT_PUBLIC_SOCKET_URL=https://operator-api.magnertia.in

# Backend URL used server-side by Next.js (NextAuth callback, /api proxy).
# Railway private networking is fastest: http://${{charge-hub-backend.RAILWAY_PRIVATE_DOMAIN}}:${{charge-hub-backend.PORT}}
BACKEND_API_URL=https://operator-api.magnertia.in

# NextAuth (Google sign-in)
NEXTAUTH_URL=https://operator.magnertia.in
NEXTAUTH_SECRET=

# Google OAuth (Google Cloud Console → Credentials)
# Authorised redirect URI: https://operator.magnertia.in/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
