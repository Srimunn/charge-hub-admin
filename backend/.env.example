# ─── Backend (Railway service: charge-hub-backend, root directory: /backend) ───
# Copy to backend/.env for local dev. On Railway, set these in the service's Variables tab.
# Never commit real values.

NODE_ENV=production
# Railway injects PORT automatically (falls back to 5000 locally).
# PORT=5000

# PostgreSQL. On Railway reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Local default (when unset in development): postgres://postgres:postgres@127.0.0.1:5432/charge_hub
DATABASE_URL=
# Set to "true" only if your Postgres needs TLS and the URL has no sslmode (Railway's private network does not).
# DATABASE_SSL=true

# Long random string (64+ chars). The frontend's NEXTAUTH_SECRET can be a different value.
JWT_SECRET=

# Comma-separated emails that are always platform admins (promoted at startup).
ADMIN_EMAILS=

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=https://operator.magnertia.in

# GST percentage applied to energy + convenience fee (default 18). Per-station value can be changed by an admin.
GST_PERCENT=18
# Largest prepaid charge a customer can buy in one order (kWh)
MAX_PREPAID_ENERGY_KWH=200

# Cloudinary — station images (Railway's disk is wiped on every deploy)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Google sign-in (same Client ID as the frontend)
GOOGLE_CLIENT_ID=

# Razorpay (live or test keys). Webhook URL: https://operator-api.magnertia.in/api/payments/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications (optional — skipped when unset)
FIREBASE_SERVICE_ACCOUNT_JSON=
RESEND_API_KEY=
EMAIL_FROM=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=EVCHRG
MSG91_SMS_FLOW_ID=

# ── OCPP chargers ──
# Chargers connect to wss://operator-api.magnertia.in/ocpp/<stationNumber> (subprotocol ocpp1.6).
# Only stations registered in the dashboard may connect. Set to "true" to allow unknown charge points (testing only).
OCPP_ALLOW_UNKNOWN_STATIONS=false
# Accept any RFID idTag presented at the charger (otherwise only app-paid and operator test starts are accepted).
OCPP_ACCEPT_ANY_IDTAG=false
# Built-in simulator for stations marked "Demo station (simulated)". Set "false" to disable it entirely.
OCPP_SIMULATOR=true

# Time zone for price windows and reports (default Asia/Kolkata)
# BUSINESS_TIMEZONE=Asia/Kolkata
# Max Postgres connections from this service (default 10)
# DATABASE_POOL_MAX=10

# Telemetry older than this is deleted (days)
TELEMETRY_RETENTION_DAYS=90

# ── Demo / testing switches — keep "false" in production ──
# Accept fake "pay_mock_*" payments without Razorpay (free charging!).
PAYMENTS_DEMO_MODE=false
# Return OTP codes in API responses.
OTP_DEBUG=false

# One-time migration only (scripts/migrate-from-mongo.js) — remove afterwards
# MONGO_URI=
